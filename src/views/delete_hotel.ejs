<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Delete Hotel</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <header class="bg-primary text-white text-center py-4">
        <h1>Delete Hotel</h1>
    </header>
    <main class="container my-5">
        <form action="/api/hotel/<%= hotel.id %>" method="POST" class="edit-hotel-form">
            <input type="hidden" name="_method" value="DELETE">
            <div class="btn-container">
                <a href="/api/hotel" class="cancel-button">Cancel</a>
                <button type="submit" class="save-button">Save Changes</button>
            </div>
        </form>
    </main>
</body>
<style>
    .bg-primary {
        background-color: #009879;
    }

    .text-white {
        color: #ffffff;
    }

    .text-center {
        text-align: center;
    }

    .py-4 {
        padding: 20px 0;
        margin-bottom: 40px;
    }

    .container {
        width: 80%;
        margin: 0 auto;
    }

    .edit-hotel-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
        max-width: 500px;
        margin: 0 auto;
        padding: 30px;
        background-color: #dddddd77;
        border-radius: 10px;
        box-shadow: 0 0 15px rgba(0, 152, 121, 0.3);
    }

    .btn-container {
        display: flex;
        justify-content: space-between;
    }

    .save-button,
    .cancel-button {
        padding: 12px 24px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .save-button {
        background-color: #009879;
        color: white;
        box-shadow: 0 4px 15px rgba(0, 152, 121, 0.3);
    }

    .save-button:hover {
        background-color: rgb(19, 78, 32);
        box-shadow: 0 6px 20px rgba(19, 78, 32, 0.4);
    }

    .save-button:active {
        transform: translateY(1px);
        box-shadow: 0 2px 10px rgba(0, 152, 121, 0.2);
        background-color: rgb(15, 62, 25);
    }

    .cancel-button {
        background-color: #ff3b3b;
        color: white;
        box-shadow: 0 4px 15px rgba(255, 59, 59, 0.3);
    }

    .cancel-button:hover {
        background-color: #d63030;
        box-shadow: 0 6px 20px rgba(214, 48, 48, 0.4);
    }
</style>

</html>