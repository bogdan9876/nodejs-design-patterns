<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hotel Add</title>
</head>

<body>
    <header class="bg-primary text-white text-center py-4">
        <h1>Add New Hotel</h1>
    </header>
    <main class="container my-5">
        <form action="/api/hotel" method="POST" class="add-hotel-form">
            <label for="name" class="form-label">Hotel Name:</label>
            <input type="text" id="name" name="name" required class="form-input">

            <label for="hotelChainId" class="form-label">Hotel Chain ID:</label>
            <input type="number" id="hotelChainId" name="hotelChainId" required class="form-input">

            <% if (typeof error !=='undefined' ) { %>
                <div style="color: red;" class="form-label">
                    <%= error %>
                </div>
                <% } %>

            <button type="submit" class="add-button">Add Hotel</button>
        </form>
    </main>
</body>

<style>
    .bg-primary {
        background-color: #009879;
    }

    .text-white {
        color: #ffffff;
    }

    .text-center {
        text-align: center;
    }

    .py-4 {
        padding: 20px 0;
        margin-bottom: 40px;
    }

    .header-title {
        font-size: 2.5em;
        font-weight: bold;
    }

    .container {
        width: 80%;
        margin: 0 auto;
    }

    .add-hotel-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
        max-width: 500px;
        margin: 0 auto;
        padding: 30px;
        background-color: #dddddd77;
        border-radius: 10px;
        box-shadow: 0 0 15px rgba(0, 152, 121, 0.3);
    }

    .form-label {
        font-size: 18px;
        font-weight: bold;
        color: #333;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-family: 'Arial', sans-serif;
    }

    .form-input {
        padding: 12px;
        border-radius: 6px;
        border: 1px solid #ccc;
        font-size: 16px;
        margin-top: -8px;
        outline: none;
        transition: border-color 0.3s ease;
    }

    .form-input:focus {
        border-color: #009879;
        box-shadow: 0 0 5px rgba(0, 152, 121, 0.3);
    }

    .add-button {
        background-color: #009879;
        color: white;
        padding: 12px 24px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 500;
        display: block;
        margin: 0 auto;
        box-shadow: 0 4px 15px rgba(0, 152, 121, 0.3);
        transition: all 0.3s ease;
    }

    .add-button:hover {
        background-color: rgb(19, 78, 32);
        box-shadow: 0 6px 20px rgba(19, 78, 32, 0.4);
    }

    .add-button:active {
        transform: translateY(1px);
        box-shadow: 0 2px 10px rgba(0, 152, 121, 0.2);
        background-color: rgb(15, 62, 25);
    }
</style>

</html>